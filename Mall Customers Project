plt.colorbar(scatter, label="Cluster")
plt.show()

# -------------------------
# 11. INTERACTIVE 2D PLOT (PLOTLY)
# -------------------------
fig2d = px.scatter(
    df,
    x="Income",
    y="Score",
    color="Segment",
    hover_data=["CustomerID", "Age"],
    title="Interactive 2D Customer Segments"
)
fig2d.show()

# -------------------------
# 12. INTERACTIVE 3D PLOT (PLOTLY)
# -------------------------
fig3d = px.scatter_3d(
    df,
    x="Age",
    y="Income",
    z="Score",
    color="Segment",
    hover_data=["CustomerID"],
    title="Interactive 3D Customer Segments"
)
fig3d.show()

# -------------------------
# 13. RECOMMENDATION ENGINE (SIMILARITY-BASED)
# -------------------------
# Since this file is customer-profile data, not product-purchase history,
# we build a customer similarity recommendation engine.
# It recommends customers with similar behavior/profile.

recommendation_features = ["Age", "Income", "Score", "Gender"]
X_rec = df[recommendation_features]

scaler_rec = StandardScaler()
X_rec_scaled = scaler_rec.fit_transform(X_rec)

nn_model = NearestNeighbors(n_neighbors=6, metric="euclidean")
nn_model.fit(X_rec_scaled)

def recommend_similar_customers(customer_id, top_n=5):
    """
    customer_id should match values from the CustomerID column, e.g. 1, 50, 120
    If CustomerID has leading zeros in CSV, pandas usually reads as integers.
    """
    customer_row = df[df["CustomerID"] == customer_id]

    if customer_row.empty:
        print(f"CustomerID {customer_id} not found.")
        return None

    idx = customer_row.index[0]
    distances, indices = nn_model.kneighbors([X_rec_scaled[idx]], n_neighbors=top_n + 1)

    rec_indices = indices[0][1:]  # exclude self
    rec_distances = distances[0][1:]

    recommendations = df.loc[rec_indices, ["CustomerID", "Age", "Income", "Score", "Segment"]].copy()
    recommendations["Distance"] = rec_distances
    return recommendations

# Example recommendation
print("\nRecommendations for CustomerID 1:")
print(recommend_similar_customers(1, top_n=5))

